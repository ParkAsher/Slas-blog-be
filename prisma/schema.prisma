generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}


// -------------------------------------- //

enum Role {
    ADMIN
    USER
}

enum PostType {
    dev
    story
}


model User {
    id String @id @default(cuid())
    email String @unique
    password String
    nickname String @unique
    role Role @default(USER)

    // ?ëŠëˆœ ï§£ì„Žâ”
    isDeleted Boolean @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    posts Post[]
    comments Comment[] @relation("CommentAuthor")
    repliedToByComments Comment[] @relation("CommentReplyToUser")
}


model Post {
    id String @id @default(cuid())

    type PostType @default(dev)

    authorId String
    author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

    title String
    content String @db.Text
    thumbnail String?
    slug String? @unique
    views Int @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    tags PostTag[]      // Tag ?ëš¯ì” é‡‰ë¶½ë‚µ M:N è­°ê³—ì”¤
    Comments Comment[]

    @@index([authorId])
    @@index([createdAt])
}

model Tag {
    id String @id @default(cuid())
    name String @unique
    createdAt DateTime @default(now())

    posts PostTag[]     // Post ?ëš¯ì” é‡‰ë¶½ë‚µ M:N è­°ê³—ì”¤

    @@index([name])
}

model PostTag {
    postId String
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

    tagId String
    tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([postId, tagId])
}

// ?ë³¤?
model Comment {
    id Int @id @default(autoincrement())

    postId String
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

    // ?ë¬’ê½¦?? ?ëš¯ì ?ëŠëˆœ/??ì £ ?? ?ë³¤??Â€ ?â‘£ë¦°æ¹²??ê¾ªë¹ nullable + SetNull
    authorId String?
    author User? @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

    // ?ëŒìŠœ
    content String @db.Text

    // è‡¾ëŒ„ë¸³ depth: ï§žê³´í€Ž éºÂ€ï§?    // Restrict: ?ã…¼ë‹”æ¿¡?éºÂ€ï§??ë³¤? hard delete ?ë‰ì“£ ?? ?ê¾¨ì˜’åª›Â€ ?ê³—ë‡™ ??ì £?ì„Žë’— ?Ñˆí€¬ç‘œ?ï§ë±ì“¬
    // hard delete??leaf ?ë…¿ë’— ?ë³¤? ï§??ë‰ìŠœ
